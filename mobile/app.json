{
  "expo": {
    "name": "LendWise",
    "slug": "lendwise-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F0E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lendwise.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F0E"
      },
      "package": "com.lendwise.mobile",
      "permissions": ["INTERNET"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "scheme": "lendwise"
  }
}
