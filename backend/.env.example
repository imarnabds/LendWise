# LendWise Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/microlend

# Cache Configuration (Redis - Optional)
REDIS_URL=redis://127.0.0.1:6379

# Authentication (JWT)
JWT_SECRET=replace_with_strong_production_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

# Firebase Service Account (Optional for Push Notifications)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
